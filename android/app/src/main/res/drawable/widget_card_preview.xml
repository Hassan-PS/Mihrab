<?xml version="1.0" encoding="utf-8"?>
<!--
  The same card, for the `previewLayout` shown in the widget picker.

  The colour is baked in rather than filtered: a preview is never updated
  by a provider, so there is nothing to recolour it, and the default
  background strength is what the widget will have when it is placed.
  Only the corners need to agree with the real thing — a picker that shows
  square cards and then places rounded ones is its own small lie.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E01C1C1E" />
    <corners android:radius="@dimen/widget_card_radius" />
</shape>
