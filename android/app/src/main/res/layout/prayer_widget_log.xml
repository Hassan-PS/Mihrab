<?xml version="1.0" encoding="utf-8"?>
<!--
  Log Today.

  Five cells, one per salāh, each a tap target that records the prayer. The
  cells are equal-weight columns rather than a grid so that the row stays
  readable when the widget is resized narrow — six of anything on a phone
  home screen is already tight, five with a name under each is the limit.

  RemoteViews has a fixed view vocabulary, so everything here is
  LinearLayout / FrameLayout / TextView with swapped background drawables.
  No custom views, no Compose: the F-Droid variant has to build this with
  nothing extra on the classpath.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E01C1C1E"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA0A6"
        android:textSize="12sp"
        android:visibility="gone" />

        <!--
            Centred, not top-anchored. A widget is only ever exactly as tall
            as its content at one size; at every other size the slack has to
            go somewhere, and pooling it under the last line reads as a card
            that ran out of things to say. Balanced above and below it reads
            as breathing room.
        -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- The date and the count. First to go on a one-row card: the
             chips carry the day and the footer carries what is next, so
             this is the line whose absence costs least. -->
        <LinearLayout
            android:id="@+id/widget_log_header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/widget_log_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_log_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />
        </LinearLayout>

        <!--
            wrap_content, not weighted. Both this row and the graph used to
            claim the card's slack, so at 4x3 they split it and the graph
            got a box four times wider than it was tall — twenty columns of
            seven rows is a 3:1 shape, so a third of the width stayed empty
            whatever was drawn in it. The chips need what they need; the
            graph is the thing that grows.
        -->
        <LinearLayout
            android:id="@+id/widget_log_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <LinearLayout android:id="@+id/log_cell_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/log_chip_0" android:layout_width="52dp" android:layout_height="38dp" android:gravity="center" android:textColor="#E8EAED" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:background="@drawable/widget_log_chip_idle" />
                <TextView android:id="@+id/log_name_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#9AA0A6" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/log_time_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            </LinearLayout>

            <LinearLayout android:id="@+id/log_cell_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/log_chip_1" android:layout_width="52dp" android:layout_height="38dp" android:gravity="center" android:textColor="#E8EAED" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:background="@drawable/widget_log_chip_idle" />
                <TextView android:id="@+id/log_name_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#9AA0A6" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/log_time_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            </LinearLayout>

            <LinearLayout android:id="@+id/log_cell_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/log_chip_2" android:layout_width="52dp" android:layout_height="38dp" android:gravity="center" android:textColor="#E8EAED" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:background="@drawable/widget_log_chip_idle" />
                <TextView android:id="@+id/log_name_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#9AA0A6" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/log_time_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            </LinearLayout>

            <LinearLayout android:id="@+id/log_cell_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/log_chip_3" android:layout_width="52dp" android:layout_height="38dp" android:gravity="center" android:textColor="#E8EAED" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:background="@drawable/widget_log_chip_idle" />
                <TextView android:id="@+id/log_name_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#9AA0A6" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/log_time_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            </LinearLayout>

            <LinearLayout android:id="@+id/log_cell_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp">
                <TextView android:id="@+id/log_chip_4" android:layout_width="52dp" android:layout_height="38dp" android:gravity="center" android:textColor="#E8EAED" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:background="@drawable/widget_log_chip_idle" />
                <TextView android:id="@+id/log_name_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#9AA0A6" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/log_time_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_log_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFFFFFF"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/widget_log_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/widget_log_foot_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- The next prayer's name, and the countdown to it. Two views
                 rather than one string because the second is a Chronometer:
                 the system ticks it, so the card counts down without this
                 process being woken to redraw it. The strip widget does the
                 same thing with the same pair of ids. -->
            <TextView
                android:id="@+id/widget_log_foot_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:maxLines="1" />

            <Chronometer
                android:id="@+id/widget_log_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <!--
            The practice graph, on a card tall enough to earn it.

            Both hidden by default and shown by the provider at a height
            where they are not a squeeze — the prayer-times widget does the
            same thing with the same bitmap, so a 4x3 of either draws the
            same weeks the same way. Below that height the widget is
            unchanged: the graph is the reward for making it taller, not a
            thing that shrinks until it is unreadable.
        -->
        <!-- The streak line, the same one the prayer-times card carries: a
             number at size with the rest muted beside it. Shown with the
             graph and hidden with it, because the two are one block. -->
        <LinearLayout
            android:id="@+id/widget_log_practice_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_log_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8EAED"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_log_practice_second"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="7dp"
                android:textColor="#9AA0A6"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_log_grid_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1FFFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!--
            Weighted, NOT wrap_content — the same shape the strip's grid
            has, and for a reason learned the hard way here: an ImageView
            that is match_parent wide, wrap_content tall and
            adjustViewBounds scales the bitmap UP to the card's width and
            takes whatever height that implies. A 120dp-wide grid became
            170dp tall, ate the row above it, and clipped the times off the
            chips. Bounded by weight it scales inside its box instead.
        -->
        <ImageView
            android:id="@+id/widget_log_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitStart"
            android:contentDescription="@string/widget_streak_grid_description"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
