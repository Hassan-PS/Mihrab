<?xml version="1.0" encoding="utf-8"?>
<!--
  Continue Reading.

  4x2. The two columns need the width: a surah name and a portion counter
  side by side in 2x2 would leave neither readable, and stacking them makes
  the card taller than the thing it is trying to be — a glance.

  updatePeriodMillis is 0. A reading position moves when a page is turned
  and the app pushes then; what changes unattended is the day, which
  ACTION_PRAYER_TIME_ELAPSED already brings round.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description_reading"
    android:initialLayout="@layout/prayer_widget_reading"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/prayer_widget_reading_preview"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="250dp"
    android:minResizeHeight="90dp"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="200dp" />
