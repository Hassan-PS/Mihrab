<?xml version="1.0" encoding="utf-8"?>
<!--
  The picker preview — static, because the picker never runs the provider
  and the real layout starts with its content `gone`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:background="@drawable/widget_card_preview"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_tasbih_label"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27"
                android:textColor="#E8EAED"
                android:textSize="34sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/widget_preview_tasbih_of"
                android:textColor="#9AA0A6"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_tasbih_today"
            android:textColor="#9AA0A6"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tasbih_primary"
            android:gravity="center"
            android:text="@string/widget_tasbih_inc"
            android:textColor="#6BC98A"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_tasbih_secondary"
                android:gravity="center"
                android:text="@string/widget_tasbih_reset"
                android:textColor="#E8EAED"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_tasbih_secondary"
                android:gravity="center"
                android:text="@string/widget_tasbih_next"
                android:textColor="#E8EAED"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
