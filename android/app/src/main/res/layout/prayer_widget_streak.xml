<?xml version="1.0" encoding="utf-8"?>
<!--
  Streak & Practice.

  The number, and ten weeks of the graph beside it. The graph is an
  ImageView holding a Bitmap rather than seventy TextViews: RemoteViews has
  no loops, so seventy cells means seventy generated ids and seventy actions
  crossing the process boundary on every update. See PracticeGridBitmap.kt.

  The grid column is `wrap_content` so the text column takes whatever is
  left — at 2x2 the bitmap is drawn narrower and the same layout holds.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E01C1C1E"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA0A6"
        android:textSize="12sp"
        android:visibility="gone" />

        <!--
            Centred, not top-anchored. A widget is only ever exactly as tall
            as its content at one size; at every other size the slack has to
            go somewhere, and pooling it under the last line reads as a card
            that ran out of things to say. Balanced above and below it reads
            as breathing room.
        -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- Centred inside the full-height column: this is where the slack
             actually is, not on the row above it. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/streak_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/streak_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E8EAED"
                    android:textSize="30sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/streak_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/streak_second"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/streak_owed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/streak_fasts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!--
            centerInside, and NO adjustViewBounds.

            The graph is drawn at the pixel size it wants (see
            PracticeGridBitmap) and must never be stretched to something else:
            an upscaled bitmap of 14px squares is a soft grey mush, and the
            squares stop reading as squares.

            `match_parent` height with `adjustViewBounds` is what made that
            happen — with an EXACTLY height spec, adjustViewBounds recomputes
            the WIDTH from the aspect ratio, so the view grew to the full
            height of the card and fitEnd blew the bitmap up to match. Height
            still follows the card, because that is what centres the graph
            against the text beside it, but centerInside only ever scales
            DOWN: crisp at every size the card is tall enough for, and shrunk
            rather than clipped when it is not.

            Staying at its natural height also keeps the graph clear of the
            launcher's rounded corners, which at one row cut well inside the
            card's own 10dp padding.
        -->
        <ImageView
            android:id="@+id/streak_grid"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/widget_streak_grid_description" />
    </LinearLayout>
</FrameLayout>
