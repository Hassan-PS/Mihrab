<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup & device-transfer rules — mirrors backup_rules.xml
  (see the rationale there). Cloud backup and device-to-device transfer
  both carry the AsyncStorage database + shared prefs. Since includes are
  present, only the included paths transfer — the large re-downloadable
  Quran content store (files/quran/) is implicitly excluded.
-->
<data-extraction-rules>
  <cloud-backup>
    <include domain="database" path="RKStorage" />
    <include domain="sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="database" path="RKStorage" />
    <include domain="sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
