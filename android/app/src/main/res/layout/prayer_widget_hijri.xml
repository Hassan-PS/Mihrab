<?xml version="1.0" encoding="utf-8"?>
<!--
  Hijri Date — the cheapest widget in the plan and close to the most useful.
  The Hijri date is the one thing in this app people look UP rather than
  read, and until now it was only available by opening Home.

  2x1: the date on the left, what is next on the right. Two columns rather
  than a stack because at one cell of height a stack gives each line about
  14dp, and the whole point of this widget is that the number is legible at
  a glance from across a desk.

  The date is not computed here. There is a tabular Umm al-Qura conversion
  in the app and a second one in Kotlin would be two implementations that
  can disagree about which day it is — and disagreeing about the date is the
  only way this widget can be wrong.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E01C1C1E"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA0A6"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/hijri_day_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8EAED"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeMaxTextSize="22sp" />

            <TextView
                android:id="@+id/hijri_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hijri_next_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/hijri_next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:gravity="end" />

            <TextView
                android:id="@+id/hijri_next_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
