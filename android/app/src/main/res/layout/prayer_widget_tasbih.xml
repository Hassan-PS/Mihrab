<?xml version="1.0" encoding="utf-8"?>
<!--
  Tasbih.

  Count on the left, three controls on the right. 4x2 rather than 2x2 because
  three tap targets in a 2x2 would each be about 20dp, and a control you have
  to aim at is not a control.

  +1 is the one people press, so it gets the whole top row and the accent
  fill; Reset and Next share the row below. Their backgrounds are swapped by
  the provider rather than declared here, because "disabled" is a state the
  payload decides — a bounded preset that has reached its target stops.

  The six dots at the bottom of the count column are the position in the
  preset cycle, so Next has somewhere visible to move to. They are six
  separate TextViews because RemoteViews has no loops.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E01C1C1E"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA0A6"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <!--
            The count column centres rather than stacking at the top.

            Its children are all wrap_content inside a full-height column, so
            they used to pile up under the label and leave the bottom half of
            the card empty next to buttons that fill it — the two sides of
            one widget disagreeing about how tall it is. Centring costs
            nothing and the number lands opposite the button that changes it.
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tasbih_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/tasbih_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E8EAED"
                    android:textSize="34sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tasbih_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tasbih_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9AA0A6"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tasbih_dot_0"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tasbih_dot_1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tasbih_dot_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tasbih_dot_3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tasbih_dot_4"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tasbih_dot_5"
                    android:layout_width="6dp"
                    android:layout_height="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tasbih_inc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/tasbih_reset"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tasbih_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
