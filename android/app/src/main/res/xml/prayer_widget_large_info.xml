<?xml version="1.0" encoding="utf-8"?>
<!--
  RETIRED. Plan phase 0: three Android providers become two, and this is the
  one that goes.

  It is not deleted, and must not be. Removing a <receiver> deletes every
  instance a user has placed — the widget simply vanishes from their home
  screen on the next boot, Android offers no migration hook, and nobody reads
  a changelog to find out why. So the receiver stays registered, keeps
  receiving updates, and renders the merged design: `selectLayout` picks the
  layout from measured size rather than from which provider class the
  instance happens to belong to, so an instance placed from this entry years
  ago is now indistinguishable from one placed from the other.

  `widgetCategory="keyguard"` is what takes it out of the picker. Lock-screen
  widgets were removed in API 21, so no launcher offers a keyguard-only
  provider — while every already-bound instance carries on being updated
  exactly as before. Disabling the component would also hide it, and would
  delete every instance with it; that is the trap this avoids.

  The label and description below are the belt to that braces: if some
  launcher does surface it anyway, what it says is true.

  Safe to delete outright two releases from now, or never — an empty receiver
  costs nothing.

  `maxResizeHeight` is raised to 600dp alongside the live entry's, and for
  the same reason: an instance placed from here before the retirement renders
  through the same `selectLayout`, so leaving 400dp would strand exactly
  those users three rows short of the footer, with no picker entry left to
  re-add themselves from.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.prayer_times.PrayerWidgetConfigureActivity"
    android:description="@string/widget_description_large_retired"
    android:initialLayout="@layout/prayer_widget"
    android:minWidth="250dp"
    android:minHeight="150dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/prayer_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetFeatures="reconfigurable"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="keyguard"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="600dp" />

