<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E01C1C1E"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#9AA0A6"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <!-- Left: Next Prayer -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0">

            <TextView
                android:id="@+id/widget_refresh_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:padding="4dp"
                android:text="↻"
                android:textColor="#80FFFFFF"
                android:textSize="16sp"
                android:contentDescription="Refresh" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/widget_next_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9AA0A6"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_next_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E8EAED"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:gravity="start"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeMaxTextSize="56sp" />

                <TextView
                    android:id="@+id/widget_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="8dp" />

                <!-- The practice merge, plan 2b. Hidden below 4x4 and hidden
                     when the app has sent no practice block: an absent block
                     is not a zero streak, and on a home screen those two look
                     identical and mean opposite things. -->
                <LinearLayout
                    android:id="@+id/widget_practice_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_practice_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E8EAED"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/widget_practice_second"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#9AA0A6"
                            android:textSize="10sp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/widget_practice_grid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="6dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/widget_streak_grid_description" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Divider -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="2dp" />

        <!-- Right: 6 Prayer Times (fill the height evenly) -->
        <LinearLayout
            android:id="@+id/widget_times_row"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <LinearLayout android:id="@+id/widget_col_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/widget_col_0_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/widget_col_0_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/widget_col_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/widget_col_1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/widget_col_1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/widget_col_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/widget_col_2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/widget_col_2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/widget_col_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/widget_col_3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/widget_col_3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/widget_col_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/widget_col_4_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/widget_col_4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/widget_col_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/widget_col_5_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:id="@+id/widget_col_5_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" />
            </LinearLayout>

            <!-- Islamic Midnight and the Last Third. Hidden unless the user
                 has turned them on: the plan's 4x3/4x4 mocks carry them, and
                 until now the app honoured those toggles everywhere except
                 the one surface that draws a whole day. Never highlighted —
                 they are on the card because the night matters, not because
                 either is what comes next. -->
            <LinearLayout android:id="@+id/widget_col_6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:visibility="gone">
                <TextView android:id="@+id/widget_col_6_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#9AA0A6" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
                <TextView android:id="@+id/widget_col_6_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9AA0A6" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" />
            </LinearLayout>

            <!-- Islamic Midnight and the Last Third. Hidden unless the user
                 has turned them on: the plan's 4x3/4x4 mocks carry them, and
                 until now the app honoured those toggles everywhere except
                 the one surface that draws a whole day. Never highlighted —
                 they are on the card because the night matters, not because
                 either is what comes next. -->
            <LinearLayout android:id="@+id/widget_col_7" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:visibility="gone">
                <TextView android:id="@+id/widget_col_7_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#9AA0A6" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
                <TextView android:id="@+id/widget_col_7_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9AA0A6" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:gravity="center_vertical" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
