<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-backup content rules (Android 11 and below path of Auto Backup).

  WHAT PERSISTS: the AsyncStorage database (RKStorage) carries every user
  preference and feature state — settings blob, journal, fasting log,
  tasbih, Quran bookmarks/khatmah/last-read (mihrab.quran.v1) — plus all
  shared preferences (widget/live-activity native prefs).

  WHAT'S EXCLUDED: the managed Quran content store (files/quran/ — mushaf
  pages + recitation audio, 100+ MB). It blows the 25 MB Auto Backup quota
  and is fully re-downloadable; the reader re-prompts on first open.

  NOTE: react-native-encrypted-storage values (saved location presets) are
  keyed to the Android Keystore, which the OS wipes on uninstall — after a
  keep-data reinstall they decrypt-fail and the app falls back gracefully
  (see __tests__/secureStorage.fallback.test.ts). Everything else resumes
  exactly where the user left off.
-->
<full-backup-content>
  <include domain="database" path="RKStorage" />
  <include domain="sharedpref" path="." />
  <exclude domain="file" path="quran" />
</full-backup-content>
