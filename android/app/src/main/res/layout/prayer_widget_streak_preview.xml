<?xml version="1.0" encoding="utf-8"?>
<!--
  The picker preview.

  A separate layout because the real one starts with its content `gone` and
  is filled by the provider, which the picker never runs — so pointing
  previewLayout at it shows an empty rectangle. Learned the hard way on the
  Log Today widget.

  The grid is an ImageView the provider fills with a Bitmap, and the picker
  has no provider, so the preview draws the shape of the thing in text
  instead of pretending to a graph it cannot render.

  HEIGHT IS match_parent, NOT A NUMBER.

  Both previews used to declare 110dp. The picker lays a previewLayout out in
  a box derived from `targetCellWidth`/`targetCellHeight`, so the number was
  answering a question the launcher had already answered — and answering it
  wrong in both directions. Streak targets one row, which is shorter than
  110dp, so its last line was pushed onto the padding and clipped. Log Today
  targets two, which is taller, so its chips were laid out in 110dp and the
  prayer names and times underneath them were sliced in half by the divider —
  the one widget in the picker that shows what it DOES, showing it broken.

  Three lines, because three is what the card shows at the size it ships at:
  the label, the number, and the one summary line beneath it. The fourth line
  this used to carry was the overflow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E01C1C1E"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_streak_title"
        android:textColor="#9AA0A6"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12"
            android:textColor="#6BC98A"
            android:textSize="30sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/widget_preview_days"
            android:textColor="#9AA0A6"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_streak_second"
        android:textColor="#9AA0A6"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
